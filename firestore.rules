rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        request.auth.token.email in ['maitrimehta3511@gmail.com', 'astrowithhrishi@gmail.com'] ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Public read for products, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read for active coupons, admin manage
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public read for published reviews, authenticated write
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    // Testimonials: public read, admin write
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Highlights: public read, admin write
    match /highlights/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers: public read, admin write
    match /offers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings / Gateway config: public read, admin write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: owner read/write, admin read/write
    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // User roles: owner read, admin read/write
    match /user_roles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Addresses: owner read/write, admin read
    match /addresses/{addressId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Wishlist items: owner read/write
    match /wishlist_items/{itemId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Login history: authenticated create, admin read
    match /login_history/{historyId} {
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow read: if isAdmin();
    }

    // Orders: owner read/write, admin read/write; customer cannot modify payment_status or status
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.user_id == request.auth.uid &&
        (!('payment_status' in request.resource.data) || request.resource.data.payment_status == resource.data.payment_status) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      );
      allow delete: if isAdmin();

      match /status_history/{historyId} {
        allow read: if request.auth != null && (get(/databases/$(database)/documents/orders/$(orderId)).data.user_id == request.auth.uid || isAdmin());
        allow create, write: if request.auth != null && (get(/databases/$(database)/documents/orders/$(orderId)).data.user_id == request.auth.uid || isAdmin());
      }

      match /admin_notes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    // Visitor leads: public create, admin manage
    match /visitor_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Appointments / Consultations: public/auth create, owner/admin read, admin manage
    match /appointments/{appId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Contact messages: public create, admin manage
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Payment Events: server/admin only
    match /payment_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // Analytics Events: public create with schema validation, admin read/manage
    match /analytics_events/{eventId} {
      allow create: if request.resource.data.event_name is string &&
                       request.resource.data.event_name.size() > 0 &&
                       request.resource.data.event_name.size() < 64 &&
                       request.resource.data.timestamp is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
